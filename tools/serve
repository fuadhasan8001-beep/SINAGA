#!/usr/bin/env bash
set -euo pipefail

SINAGA_HOST="${SINAGA_HOST:-127.0.0.1}"
SINAGA_PORT="${SINAGA_PORT:-8000}"
while (($#)); do
    case "$1" in
        --host=*) SINAGA_HOST="${1#*=}" ;;
        --host) shift; SINAGA_HOST="${1:-127.0.0.1}" ;;
        --port=*) SINAGA_PORT="${1#*=}" ;;
        --port) shift; SINAGA_PORT="${1:-8000}" ;;
    esac
    shift
done

cd "$(dirname "$0")/../public"
exec php -d upload_max_filesize=12M -d post_max_size=16M -d max_file_uploads=20 -d max_input_time=120 \
    -S "${SINAGA_HOST}:${SINAGA_PORT}" ../vendor/laravel/framework/src/Illuminate/Foundation/resources/server.php
